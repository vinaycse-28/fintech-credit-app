# Backend Environment Configuration
# Copy this to .env and adjust as needed

# SQLite (default - works out of the box)
DATABASE_URL=sqlite:///./creditbridge.db

# PostgreSQL (uncomment to use with Supabase or local PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/creditbridge

# CORS: Comma-separated list of allowed origins for the Vite frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
